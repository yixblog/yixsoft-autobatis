# PostgreSQL 本地测试配置模板
# 请复制此文件为 application-pg-local.yml 并填写您的测试数据库连接参数
# 此文件已在 .gitignore 中配置，不会被提交到 git

spring:
  datasource:
    driver-class-name: org.postgresql.Driver
    # 请修改以下连接参数
    url: jdbc:postgresql://localhost:5432/dbname
    username: user
    password: pwd

debug: true

mybatis:
  default-key-generator: com.yixsoft.support.mybatis.autosql.pk.UUIDPkProvider
  configuration:
    mapUnderscoreToCamelCase: true
  dialects:
    - com.yixsoft.support.mybatis.dialects.pg.PostgreSqlDialect
  paginator:
    enable: true
    advanced-count: true
    dialect: com.github.miemiedev.mybatis.paginator.dialect.PostgreSQLDialect
  enable-strict-table-check: true

logging:
  level:
    root: debug
    java:
      sql:
        Connection: debug
        Statement: debug
        PreparedStatement: debug
